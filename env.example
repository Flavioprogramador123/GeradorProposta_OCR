# 🔐 CONFIGURAÇÃO DE APIS - EXEMPLO
# Copie este arquivo para .env e preencha com suas chaves reais
# ⚠️ NUNCA commite arquivos .env com chaves reais no Git!

# ===========================================
# 🤖 PROVEDORES DE IA
# ===========================================

# Gemini API (Gratuito - 1M tokens/dia)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Pago)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API (Alternativo)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===========================================
# 📁 GOOGLE DRIVE API
# ===========================================

# Credenciais OAuth 2.0
GOOGLE_DRIVE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-your_client_secret

# Refresh Token (gerado automaticamente)
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_here

# ===========================================
# 🗺️ GOOGLE MAPS API
# ===========================================

# Para geolocalização e HSP por região
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# ⚙️ CONFIGURAÇÕES DO SISTEMA
# ===========================================

# Controle de IA
AI_ENABLED=true
AI_MAX_TOKENS=4096
AI_DAILY_TOKEN_LIMIT=10000
AI_DEFAULT_MODEL=gemini-1.5-pro
AI_VISION_MODEL=grok-vision-beta

# URLs de produção
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# ===========================================
# 🖼️ CONFIGURAÇÃO DE LOGOS
# ===========================================

# Logo para Open Graph (WhatsApp, Facebook, etc.)
# Opções disponíveis:
# - /assets/logos/logo-pieng-principal.jpg (padrão - JPG com fundo)
# - /assets/logos/logo-pieng-oficial.png (PNG - pode ter fundo transparente)
# - /assets/logos/logo.png (logo simples)
# - /assets/logos/logo-pieng.png (outra variação)
NEXT_PUBLIC_OG_LOGO=/assets/logos/logo-pieng-principal.jpg

# Logo para favicon (ícone do navegador)
NEXT_PUBLIC_FAVICON_LOGO=/assets/logos/logo-pieng-principal.jpg

# Logo para propostas HTML (template)
NEXT_PUBLIC_PROPOSAL_LOGO=/assets/logos/logo.png

# ===========================================
# 🗄️ SUPABASE (Banco de Dados)
# ===========================================

# URL do projeto Supabase
# Obtenha em: https://supabase.com/dashboard/project/asmvbrcxzvfvvolnalxw → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://asmvbrcxzvfvvolnalxw.supabase.co

# Chave anon (pública) - segura para usar no frontend
# Obtenha em: https://supabase.com/dashboard/project/asmvbrcxzvfvvolnalxw → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Chave service_role (OPCIONAL - apenas para operações admin no backend)
# ⚠️ NUNCA exponha essa chave no frontend!
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# 🚀 DEPLOYMENT
# ===========================================

# Para Google Cloud Run / App Engine
PORT=3000
NODE_ENV=production

# Para Vercel (se usar)
VERCEL_URL=your-vercel-url.vercel.app
