# 🔧 PIENG Next.js v2.0 - Variáveis de Ambiente
# Copiar este arquivo para .env e preencher os valores

# ===========================================
# 🚀 VERCEL DEPLOYMENT
# ===========================================
# Token de autenticação do Vercel para deploy automático
# Obter em: https://vercel.com/account/tokens
VERCEL_TOKEN=seu_token_vercel_aqui

# ===========================================
# 🌞 CONFIGURAÇÕES PIENG
# ===========================================
# Configurações específicas do sistema PIENG (se necessário no futuro)
# PIENG_API_URL=https://api.piengsolucoes.com.br
# PIENG_API_KEY=sua_api_key_aqui

# ===========================================
# 🔒 CONFIGURAÇÕES DE SEGURANÇA
# ===========================================
# Autenticação Admin (Basic Auth)
ADMIN_USERNAME=pieng
ADMIN_PASSWORD=pieng2025

# Chave secreta para JWT ou sessões (futuro)
# NEXTAUTH_SECRET=sua_chave_secreta_aqui
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# 🤖 APIs DE IA
# ===========================================
# Gemini (Google AI) - 1M tokens/dia gratuito (prioridade 1)
GEMINI_API_KEY=sua_chave_gemini_aqui

# OpenAI (opcional - prioridade 2)
# OPENAI_API_KEY=sua_chave_openai_aqui

# OpenRouter (opcional - prioridade 3)
# OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Controle de IA
AI_ENABLED=true
AI_MAX_TOKENS=4096
AI_DAILY_TOKEN_LIMIT=10000

# Google Maps API (para HSP e geolocalização)
apigooglemaps=sua_chave_google_maps_aqui

# ===========================================
# 📊 INTEGRAÇÕES EXTERNAS
# ===========================================
# Google Analytics (se necessário)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Webhook para notificações (se necessário)
# WEBHOOK_URL=https://hooks.slack.com/services/...

# ===========================================
# 💾 ARMAZENAMENTO DE ARQUIVOS
# ===========================================
# OPÇÃO 1: Supabase Storage (Recomendado para produção)
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# OPÇÃO 2: Google Drive API (Backup automático)
# GOOGLE_DRIVE_CLIENT_ID=seu_client_id
# GOOGLE_DRIVE_CLIENT_SECRET=seu_client_secret
# GOOGLE_DRIVE_REFRESH_TOKEN=seu_refresh_token
# GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_pieng_propostas

# ===========================================
# 💾 BANCO DE DADOS (FUTURO)
# ===========================================
# Se migrar para banco de dados no futuro
# DATABASE_URL=postgresql://user:pass@host:port/db
# REDIS_URL=redis://user:pass@host:port

# ===========================================
# 📝 NOTAS DE USO
# ===========================================
# 1. Nunca commitar o arquivo .env no Git
# 2. Manter este .env.example atualizado
# 3. Verificar se todas as variáveis necessárias estão configuradas
# 4. Para desenvolvimento local, só VERCEL_TOKEN é obrigatório