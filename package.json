{
  "name": "pieng-propostas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "build:exe": "next build && pkg . --output dist/pieng-propostas.exe",
    "build:standalone": "next build && next-standalone"
  },
  "pkg": {
    "scripts": ".next/**/*.js",
    "assets": [
      "public/**/*",
      "src/data/**/*",
      ".next/static/**/*",
      ".next/server/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.76.1",
    "@types/recharts": "^1.8.29",
    "chart.js": "^4.4.0",
    "date-fns": "^2.30.0",
    "formidable": "^3.5.4",
    "googleapis": "^128.0.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.544.0",
    "next": "^13.5.0",
    "openai": "^6.3.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "recharts": "^2.8.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.16",
    "pkg": "^5.8.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0"
  }
}
